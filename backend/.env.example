PROXY_URI=http://127.0.0.1:2081

# KuCoin Configuration
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
KUCOIN_DEFAULT_SYMBOLS=PAXG-USDT

# Binance Configuration
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEFAULT_SYMBOLS=PAXG-USDT

# Nobitex Configuration
# Symbols format: Base-Quote (e.g. USDT-IRT,BTC-IRT)
NOBITEX_DEFAULT_SYMBOLS=USDT-IRT
# Token for wallet balance fetching (optional) - Get from: https://nobitex.ir/app/settings/
NOBITEX_TOKEN=

# MetaTrader 5 Configuration
# MetaTrader has no server-side API, so the terminal pushes to us instead:
# the ArbiPriceFeed Expert Advisor (mt5/ArbiPriceFeed.mq5) POSTs ticks to
# /api/mt5/ticks. The endpoint is only registered when this token is set.
MT5_INGEST_TOKEN=
# Seconds without a fresh tick before a quote loses its price levels (default 90)
MT5_STALE_SECONDS=90
